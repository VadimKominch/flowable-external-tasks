<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:flowable="http://flowable.org/dmn" xmlns:design="http://flowable.org/design" id="definition_processTable" name="process table" namespace="http://www.flowable.org/dmn">
  <decision id="processTable" name="process table">
    <decisionTable id="decisionTable_processTable" hitPolicy="FIRST">
      <input label="choice">
        <inputExpression id="inputExpression_1" typeRef="number">
          <text>choice</text>
        </inputExpression>
      </input>
      <output id="outputExpression_2" name="processName" typeRef="string"></output>
      <rule>
        <inputEntry id="inputEntry_1_1">
          <text><![CDATA[== 0]]></text>
        </inputEntry>
        <outputEntry id="outputEntry_2_1">
          <text><![CDATA["process1"]]></text>
        </outputEntry>
      </rule>
      <rule>
        <inputEntry id="inputEntry_1_2">
          <text><![CDATA[== 1]]></text>
        </inputEntry>
        <outputEntry id="outputEntry_2_2">
          <text><![CDATA["process2"]]></text>
        </outputEntry>
      </rule>
      <rule>
        <inputEntry id="inputEntry_1_3">
          <text><![CDATA[-]]></text>
        </inputEntry>
        <outputEntry id="outputEntry_2_3">
          <text><![CDATA["process3"]]></text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI></dmndi:DMNDI>
</definitions>